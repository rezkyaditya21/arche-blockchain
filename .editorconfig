root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,jsx,ts,tsx,css,scss,html,py,rs,php}]
indent_style = space
indent_size = 2

[*.{py,rs,php}]
indent_size = 4

[Makefile]
indent_style = tab
